# Leave blank for the browser-local demo (the default).
# To enable cloud sync, set to the origin of your protected API.
# For a same-origin site this is its own full origin, e.g. https://goals.example.com.
# The dashboard calls GET/PUT <origin>/api/store with browser credentials.
# NEVER place a token or password in a VITE_ setting; it is public in the build.
VITE_GOALS_API_URL=
